# Nothing is required here: on first run the app opens a setup screen where you
# paste your MongoDB connection string and create your admin account, and all
# other settings (email provider, sender, app URL...) are edited in Settings.
#
# Optional overrides for servers / deployments:

# Use this connection string instead of the one saved by the setup screen.
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/marketing

# Fixed secret for sessions and signed links (otherwise one is generated and
# stored in the database).
# AUTH_SECRET=
